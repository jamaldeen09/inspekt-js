{
  "name": "@inspekt/js",
  "version": "0.0.4",
  "description": "High-fidelity AI diagnostics for API failures. Stream real-time autopsies directly to your terminal.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./nest": {
      "types": "./dist/adapters/nest.d.ts",
      "import": "./dist/adapters/nest.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/jamaldeen09/inspekt-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamaldeen09/inspekt-js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "monitoring",
    "ai",
    "diagnostics",
    "observability",
    "express",
    "nestjs",
    "fastify",
    "middleware",
    "logging"
  ],
  "author": "jamaldeen.o",
  "license": "MIT",
  "dependencies": {
    "fastify-plugin": "^5.1.0",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "express": "^5.2.1",
    "fastify": "^5.8.4",
    "rxjs": "^7.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}